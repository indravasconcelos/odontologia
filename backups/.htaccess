# ===================================================================
#  backups/ - copias do banco de dados
#  Esta pasta NUNCA deve ser acessada pela web.
#  Guarde as copias fora do servidor: baixe-as para o seu computador.
# ===================================================================

# Apache 2.4 (Hostinger / LiteSpeed)
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (fallback)
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Nunca lista o conteudo
Options -Indexes

# Backups contem dados pessoais: nao deixa o navegador guardar cache
<IfModule mod_headers.c>
    Header set Cache-Control "no-store, no-cache, must-revalidate"
</IfModule>