# ===================================================================
#  CONFIGURACAO - copie para .env e preencha
#  O .env NUNCA deve ir para o Git nem para a hospedagem publica.
# ===================================================================

# ---------- Aplicacao ----------
# Local (servidor portatil da pasta _demo)
APP_URL=http://localhost:8080

# Na Hostinger, troque para o dominio, por exemplo:
# APP_URL=https://www.seudominio.com.br

# Minutos de inatividade para encerrar a sessao do painel
SESSAO_MINUTOS=30

# ---------- Usuario administrativo inicial ----------
# Usado uma unica vez por database/instalar.php.
# Depois de criar a conta, troque a senha em /admin > Minha conta.
ADMIN_NOME=Dr. Maycon Gomes
ADMIN_EMAIL=admin@odontologia.local
ADMIN_SENHA=Demo@2026

# Token para rodar database/instalar.php pela web na Hostinger.
# Gere um novo: php -r "echo bin2hex(random_bytes(24));"
INSTALAR_TOKEN=troque-este-valor

# ---------- Banco MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=odontologia
DB_USER=odontologia
DB_PASSWORD=Demo@2026
DB_CHARSET=utf8mb4

# Na Hostinger use os dados do painel > Bancos de Dados, por exemplo:
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=u123456789_odontologia
# DB_USER=u123456789_odont
# DB_PASSWORD=a_senha_que_voce_definir

# ---------- Agente de IA (DeepSeek) ----------
# AI_MODO:
#   local     -> respondedor proprio, sem chave e sem internet (demonstracao)
#   deepseek  -> usa a API da DeepSeek (exige DEEPSEEK_API_KEY)
#   auto      -> deepseek se houver chave, senao local
#   desligado -> o chat so oferece atendimento humano (emergencia)
AI_MODO=local

# Preencha quando tiver a chave. Ela NUNCA aparece no site.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- E-mail (recuperacao de senha) ----------
# Sem SMTP_HOST o sistema usa a funcao mail() do PHP, que funciona
# na Hostinger. Em desenvolvimento, o conteudo cai em _demo/logs/mail.log
EMAIL_USER=
EMAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Dr. Maycon Gomes

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=tls

# ---------- Regras da agenda ----------
# Antecedencia minima para agendar (minutos)
AGENDA_ANTECEDENCIA=120
# Quantos dias a frente o visitante consegue marcar
AGENDA_DIAS_A_FUTURO=60